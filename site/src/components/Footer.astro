---
import { url } from '../lib/url';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>
      <em>Pro Git</em> by Scott Chacon and Ben Straub, licensed under
      <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" rel="noopener">CC BY-NC-SA 3.0</a>.
    </p>
    <p>
      <a href={url('/book/')}>Read the book</a> ·
      <a href={url('/history/')}>History</a> ·
      <a href="https://github.com/progit/progit3" rel="noopener">Source on GitHub</a> ·
      <a href="https://git-scm.com/book" rel="noopener">git-scm.com/book</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background: var(--bg-inset);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.4rem;
    padding-bottom: 1.6rem;
  }

  .site-footer a {
    color: var(--muted);
    text-decoration-color: var(--border);
  }

  .site-footer a:hover {
    color: var(--accent);
  }
</style>
